<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/primary">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings" />

    </LinearLayout>

    <!-- URL Input Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/surface">

        <EditText
            android:id="@+id/et_url_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/paste_url_hint"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:background="@drawable/edit_text_bg"
            android:textColorHint="@android:color/darker_gray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center">

            <Button
                android:id="@+id/btn_download"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/download"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_primary" />

            <Button
                android:id="@+id/btn_scan_qr"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/scan_qr"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_secondary" />

        </LinearLayout>

    </LinearLayout>

    <!-- Recent Downloads / Trending -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recent_searches"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recent_searches"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

    <!-- Supported Platforms -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/supported_platforms"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <GridView
            android:id="@+id/gv_platforms"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:numColumns="3"
            android:layout_marginTop="12dp"
            android:verticalSpacing="8dp"
            android:horizontalSpacing="8dp" />

    </LinearLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layout_gravity="bottom"
        android:background="@color/surface"
        android:gravity="center">

        <Button
            android:id="@+id/btn_nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Home"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/btn_nav_downloads"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Downloads"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/btn_nav_favorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Favorites"
            android:background="@android:color/transparent" />

    </LinearLayout>

</LinearLayout>
